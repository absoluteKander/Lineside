<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lineside never touches the network. Strip these even if a library asks for them;
         the build also fails if either shows up in a merged manifest. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- WorkManager asks for this for long-running work, which Lineside never does. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- Optional. Lets loops show by name and status on the phone app's call screen. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Granted at install, no prompt: used only to mark Lineside's account as never-syncing. -->
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />

    <!-- Optional. Know when a call is answered and ends, for note timestamps and call length. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Optional. The quiet "Tap to jot a note" for calls answered on the lock screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Granted at install, no prompt: lets the app lock ask for the phone's own screen lock (fingerprint, face, PIN). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Optional. The pill during and just after calls. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Backup stays off until the user chooses it during onboarding (custom BackupAgent, later). -->
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lineside">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sees each call's number as it starts. Never blocks, silences or changes a call. -->
        <service
            android:name=".calls.ScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- "Share → Lineside" for a voicemail or a text from another app. Text is kept; audio never is. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Add to a loop"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Telecom opens this in the call-screening app when any call ends. Invisible. -->
        <activity
            android:name=".calls.PostCallActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.telecom.action.POST_CALL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Opened by the call notification; shows the pill, then disappears. -->
        <activity
            android:name=".calls.PillLauncherActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <!-- "Keep" on a quiet-loop reminder. -->
        <receiver
            android:name=".KeepReceiver"
            android:exported="false" />

        <!-- Lineside's local account for loop contacts. No login, no server, never syncs. -->
        <service
            android:name=".contacts.AuthenticatorService"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

        <!-- A sync adapter that never syncs: Contacts apps need one to show an account's contacts. -->
        <service
            android:name=".contacts.SyncService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/syncadapter" />
            <meta-data
                android:name="android.provider.CONTACTS_STRUCTURE"
                android:resource="@xml/contacts" />
        </service>
    </application>
</manifest>
